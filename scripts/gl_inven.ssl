/*
 * gl_inven.ssl  --  make the inventory, loot and barter windows legible.
 *
 * These four windows are the same window wearing different hats -- sfall gives
 * them all one WINTYPE_INVENTORY -- and all four are pure drag-and-drop. There
 * is no keyboard selection of an item anywhere in them, so a blind player gets
 * nothing at all: a pot with three things in it and a screen reader that says
 * nothing is indistinguishable from an empty pot.
 *
 * This script reads the lists out of the engine and reports them. It sends no
 * input and moves no item. Pointing at a slot and clicking it is the Python
 * side's job, for the same reason walking is: putting the mouse somewhere is
 * the part a blind player cannot do, and deciding what happens when it lands is
 * the part the game should keep deciding.
 *
 * WHY NOT JUST MOVE THE ITEMS FROM HERE. add_obj_to_inven and friends would
 * make this a twenty-line script with no aiming in it at all. They would also
 * step straight past every rule the inventory window enforces -- carry weight,
 * the action point cost of an inventory action in combat, whatever else is in
 * there that nobody has thought of. Going through the real UI means those rules
 * apply because they are the same code, rather than because we remembered to
 * reimplement them. The goal is access to Fallout 2, not an easier Fallout 2.
 *
 * The keys mirror the hex cursor's, so there is one spatial idea to learn:
 *
 *      8 / 2   previous / next item in this list
 *      4 / 6   previous / next list -- yours, theirs, what you are wearing
 *      5       re-read the selected item
 *      0       what is open, and what is in it
 *
 * Output goes to debug.log as "INVEN:" lines. The engine's own prose along the
 * bottom of the screen ("You have no room", weight refusals) is read separately
 * out of memory, so nothing here needs to reproduce it.
 *
 * Compile from data/scripts (two steps -- packaged compiler preprocessor bug):
 *   compile.exe -P gl_inven.ssl
 *   compile.exe gl_inven.preprocessed.ssl -o gl_inven.int
 */

#include "sfall/sfall.h"
#include "sfall/dik.h"
#include "sfall/define_lite.h"
#include "sfall/define_extra.h"

// Fields are separated by '|' because item names contain spaces, and every
// line also ENDS with one: the engine appends its own debug output to ours
// without always starting a new line, so the terminator gives that noise a
// final field nobody reads instead of letting it corrupt an item's name.
#define SEP                 ("|")

// The windows this script owns the keyboard for. get_game_mode is a bitmask,
// so membership is tested with bwand -- the same lesson gl_world.ssl learned
// three times over.
#define INVEN_MODES         (INVENTORY bwor INTFACELOOT bwor INTFACEUSE bwor BARTER)

#define SIDE_MINE           (0)
#define SIDE_THEIRS         (1)
#define SIDE_WORN           (2)

/*
 * Dropping, done the way the engine's own Drop icon does it.
 *
 * The inventory's item menu (hold the button on an item: Look, Use, Drop,
 * Unload) handles Drop at 0x004736E8, and these are the calls it makes, read
 * out of that handler. There is no gesture to send instead: a release over the
 * character figure -- what the mod used to try -- only takes things out of a
 * bag opened inside the inventory (the hit test at 0x00471443 is gated on that
 * stack being open), and at the top level puts the item straight back.
 */
#define F_OBJ_DROP          (0x0049B8B0)  // (critter, item): one unit to the ground
#define F_ITEM_ADD_FORCE    (0x004772B8)  // (critter, item, count)
#define F_ITEM_REMOVE_MULT  (0x00477490)  // (critter, item, count)
#define F_CAPS_SET_AMOUNT   (0x0047A8D8)  // (money, amount)
#define F_TAKE_OFF_ARMOR    (0x004715F8)  // (critter, armour, 0)
#define F_INVEN_CURSOR      (0x00470BCC)  // (1): the window's own cursor back
#define F_DRAW_BODY         (0x00471D5C)  // the figure and both hands
#define F_DRAW_INVENTORY    (0x0046FDF4)  // (scroll, -1, window type)
#define INVEN_DUDE          (0x0059E86C)  // whose inventory the window shows
// While the window is open the engine holds the worn items in these, out of
// the inventory list, and puts them back when it closes.
#define WORN_ARMOR_VAR      (0x0059E954)
#define WORN_LEFT_VAR       (0x0059E958)
#define WORN_RIGHT_VAR      (0x0059E968)
#define INVEN_STACK_DEPTH   (0x0059E96C)  // bags opened inside the inventory
#define INVEN_SCROLL        (0x0059E844)  // one scroll offset per depth
#define EXPLOSIVE_DROPPED   (0x005190E0)  // set when an armed charge is dropped
#define PID_MONEY_          (41)
#define PID_DYNAMITE_LIVE   (206)
#define PID_PLASTIC_LIVE    (209)
/*
 * The barter window has FOUR item lists, not two, and the two in the middle
 * are the whole point of it: what you are offering, and what you are asking
 * for. Nothing could see them before, which is why barter read out both
 * inventories perfectly and was still unplayable -- you could hear what was
 * for sale and never find out what you had put on the table.
 *
 * They are not inventories of anybody. The engine builds two temporary objects
 * when the screen opens, moves items into them, and destroys them afterwards,
 * so there is no critter to ask and no address that stays put between one
 * barter and the next. What there is, is sfall's barter-price hook: it runs
 * inside the engine's own price calculation and is handed both tables as
 * arguments. So they are caught there and remembered for as long as the screen
 * is up. See on_barterprice.
 */
#define SIDE_MY_OFFER       (3)
#define SIDE_THEIR_OFFER    (4)
#define SIDES               (5)

// Worn and wielded slots, in the order the window draws them down the middle.
#define WORN_SLOTS          (3)

variable g_lastmode := -1;
variable g_side := SIDE_MINE;
variable g_index := 0;
variable g_label := "";
variable g_count := 0;
// Rounds in an ammunition stack, all boxes counted; -1 for anything else.
variable g_rounds := -1;
variable g_item := 0;
variable g_other := 0;
variable g_imenu := 0;
variable g_imenu_index := 0;
// "Drop how many?", asked by this script. See drop_ask.
variable g_dropask := 0;
variable g_dropn := 0;
variable g_dropmax := 0;
variable g_droptyped := 0;
variable g_dropitem := 0;
variable g_dropowner := 0;
// The two barter tables, as handed over by HOOK_BARTERPRICE. Zero whenever the
// barter screen is not up, which is what makes the two extra sides disappear
// from an ordinary inventory or a corpse.
variable g_myoffer := 0;
variable g_theiroffer := 0;

/*
 * KEY_SWALLOW  --  how to actually take a key away from the engine.
 *
 * **Not zero.** sfall's own documentation for HOOK_KEYPRESS is explicit:
 *
 *     int ret0 - overrides the pressed key
 *                (a new key DX scancode or 0 for no override)
 *
 * So returning 0 means "leave the key alone", which is the exact opposite of
 * what these scripts believed. Every key they thought they were swallowing
 * reached the game as well, and had done since the first one was written.
 *
 * That single misunderstanding is three separate bugs. Numpad 1 stepped the
 * look cursor south-west and ALSO arrived as the character '1', which on the
 * map toggles sneak -- so walking turned stealth on and off. The numpad still
 * picked dialogue replies. The numpad still scrolled the map underneath the
 * action menu. Each was "fixed" by returning zero once more, and each fix did
 * nothing at all.
 *
 * There is no documented block value, so the key is overridden with one the
 * game does nothing with. Scroll Lock is bound to nothing in Fallout 2, and to
 * nothing in ddraw.ini either -- every key setting there is 0, -1, 42 or 29.
 *
 * The same documentation adds that the override must be the SAME scancode for
 * the press and the release. That is why neither handler drops key-up on the
 * floor any more: hiding the press while letting the release through leaves
 * the engine holding half an event, which is enough for it to act.
 */
#define KEY_SWALLOW  (DIK_SCROLL)

procedure start;
procedure poll_inven;
procedure on_key;
procedure imenu_open;
procedure imenu_close;
procedure imenu_step(variable delta);
procedure imenu_do;
procedure imenu_label(variable which);
procedure worn_slot(variable index);
procedure side_owner(variable side);
procedure side_count(variable side);
procedure side_usable(variable side);
procedure side_item(variable side, variable index);
procedure describe_item;
procedure describe_side;
procedure announce_open;
procedure summarise;
procedure drop_item;
procedure drop_now(variable owner, variable item, variable n);
procedure drop_ask_key(variable key);
procedure drop_ask_report;
procedure stack_quantity(variable owner, variable item);
procedure inven_redraw;
procedure step_item(variable delta);
procedure step_side(variable delta);
procedure other_obj;
procedure on_barterprice;

/*
 * start  --  init once, then poll.
 *
 * Same shape as the other two scripts: game_loaded is true only on the first
 * call, so the true branch sets up and the false branch is the periodic poll.
 * set_global_script_repeat is what makes the false branch happen at all --
 * without it the script runs exactly once per session and every watcher below
 * is dead code, which cost gl_world.ssl a whole debugging round.
 */
procedure start begin
   if game_loaded then begin
      set_global_script_type(1);
      set_global_script_repeat(2);   // ~30 polls/sec; only watching a mode flag
      register_hook_proc(HOOK_KEYPRESS, on_key);
      register_hook_proc(HOOK_BARTERPRICE, on_barterprice);
      debug_msg("INVEN:ready" + SEP);
   end else begin
      call poll_inven;
   end
end

/*
 * poll_inven  --  notice the window opening and closing.
 *
 * Opening is the moment that matters. A sighted player sees a pot's contents
 * the instant the window appears; announcing on entry is what makes that the
 * same event rather than something the player has to go and ask for.
 */
procedure poll_inven begin
   variable m, was;

   m := get_game_mode bwand INVEN_MODES;
   if (m == g_lastmode) then return;

   was := g_lastmode;
   g_lastmode := m;

   if (m) then begin
      // A fresh window starts at the top of the most interesting list. When
      // there is a container, that is the container: you opened it to find out
      // what was in it.
      g_index := 0;
      g_side := SIDE_MINE;
      if (side_count(SIDE_THEIRS) > 0) then g_side := SIDE_THEIRS;
      call announce_open;
      call describe_side;
   end else if (was) then begin
      /*
       * The engine destroys the two barter tables when the screen closes, so
       * holding on to the pointers would leave two sides pointing at freed
       * memory -- and this script has hard-crashed the game twice already by
       * handing the engine an object it did not expect.
       */
      g_myoffer := 0;
      g_theiroffer := 0;
      // A count being asked for dies with the window, and so does its item.
      g_dropask := 0;
      g_dropitem := 0;
      g_dropowner := 0;
      debug_msg("INVEN:close" + SEP);
   end
end

/*
 * load_other  --  whatever is on the far side of this window, into g_other.
 *
 * loot_obj is the engine's own answer for a container or a corpse, which saves
 * guessing from what the player last clicked -- and it stays right if the
 * window was opened some way the mod did not drive. In barter the far side is
 * the person you are trading with, which is dialog_obj.
 *
 * Sets a global rather than returning, because a procedure that takes no
 * arguments and returns a value is the one shape of SSL procedure nothing else
 * in this project relies on, and an inventory window is not the place to find
 * out whether the compiler treats it as a call or as a name.
 */
procedure load_other begin
   g_other := loot_obj;
   if (not g_other) then g_other := dialog_obj;
end

procedure side_owner(variable side) begin
   if (side == SIDE_THEIRS) then begin
      call load_other;
      return g_other;
   end
   if (side == SIDE_MY_OFFER) then return g_myoffer;
   if (side == SIDE_THEIR_OFFER) then return g_theiroffer;
   return dude_obj;
end

/*
 * inven_size  --  how many things are in an inventory.
 *
 * Counted by walking it, which looks wasteful next to get_current_inven_size
 * and is the only thing that is actually true. That function does NOT return
 * an item count: measured against a live game, a character carrying one Spear
 * of weight 4 reported a size of 4. Trusting it invented three items that were
 * not there, and stepping onto each of them read out nothing at all -- which is
 * indistinguishable from the key not working, and was reported as exactly that.
 *
 * Walking to the first null is the pattern sfall's own lib.inven.h uses, and it
 * works the same for a critter and for a pot.
 */
procedure inven_size(variable owner) begin
   variable n;
   n := 0;
   // Bounded. An unbounded while over an engine call that might not terminate
   // the way we expect is a hang inside the game's own loop, with no way out.
   while (n < 250) do begin
      if (not inven_ptr(owner, n)) then return n;
      n := n + 1;
   end
   return n;
end

procedure side_count(variable side) begin
   variable owner;
   owner := side_owner(side);
   if (not owner) then return 0;
   if (side == SIDE_WORN) then return WORN_SLOTS;
   return inven_size(owner);
end

/*
 * side_item  --  the object at `index` on a side, or 0.
 *
 * The worn side is a fixed three slots rather than a list, because that is what
 * it is: armour, and the two hands. An empty slot is a real answer there --
 * "ITEM2, empty" tells you that you have a free hand -- so it returns 0 without
 * that meaning the index was out of range.
 */
procedure side_item(variable side, variable index) begin
   variable owner;
   owner := side_owner(side);
   if (not owner) then return 0;
   if (side == SIDE_WORN) then begin
      variable slot, a, b;
      if (index == 0) then slot := INVEN_TYPE_WORN;
      else if (index == 1) then slot := INVEN_TYPE_RIGHT_HAND;
      else slot := INVEN_TYPE_LEFT_HAND;

      /*
       * Two ways of asking, because the obvious one is wrong for hands.
       *
       * critter_inven_obj reports a hand's contents only while that hand is the
       * ACTIVE one. A spear dragged into Item 1 read back as an empty slot, and
       * pressing B in the world -- which switches the active hand -- made it
       * appear, and pressing B again made it vanish. So the mod called a
       * successful equip a failure and then described the slot as empty while
       * the character was holding the thing.
       *
       * critter_inven_obj2 is sfall's replacement and does not have that
       * behaviour. Both are read and both are logged, so if the replacement is
       * ever the one that is wrong, the log says so rather than the player
       * having to notice.
       */
      a := critter_inven_obj2(owner, slot);
      b := critter_inven_obj(owner, slot);
      if (a != b) then begin
         debug_msg("INVEN:slotdbg " + index + SEP + slot
            + SEP + (a != 0) + SEP + (b != 0) + SEP);
      end
      if (a) then return a;
      return b;
   end
   if (index < 0) then return 0;
   return inven_ptr(owner, index);
end

/*
 * describe_item  --  name, how many, and what it weighs.
 *
 * The name is the game's own, so translations and content mods come along
 * untouched. The quantity is the engine's count of that prototype in the same
 * inventory, which is what a stack in the window means. Weight is the engine's
 * per-item figure.
 *
 * Everything is logged rather than assembled into a sentence here: the Python
 * side does the wording, as it does for hexes and the scanner, so that the
 * phrasing lives in one place and can be changed without a game restart.
 */
procedure describe_item begin
   variable owner, qty;

   g_label := "";
   g_count := 0;
   g_rounds := -1;
   if (not g_item) then return;

   g_label := obj_name(g_item);
   owner := side_owner(g_side);
   qty := 0;
   if (owner and g_side != SIDE_WORN) then begin
      qty := obj_is_carrying_obj_pid(owner, obj_pid(g_item));
   end

   /*
    * Ammunition is BOXES and rounds, and each number on its own was a bug.
    *
    * The box count came first and read "10mm JHP" with no number -- one box
    * of 23 rounds is a quantity of one, which the reader suppresses as noise.
    * So the count was replaced by the charge field, OBJ_DATA_CUR_CHARGES, and
    * that was wrong the other way: the charge field is the rounds in the TOP
    * box only. Sajag had four full boxes of 10mm JHP, the line said "24", and
    * the barter hook valued them at 300 -- four boxes at 75, which is what
    * gave it away.
    *
    * So the count is the boxes again, because that is what the "Move Items"
    * window counts and what a price is per; and the rounds go in a field of
    * their own at the end of the line, as the full boxes plus the top one.
    * obj_is_carrying_obj counts THIS stack rather than every stack with its
    * pid, which is the number the move window will stop at.
    */
   g_rounds := -1;
   if (obj_item_subtype(g_item) == item_type_ammo) then begin
      if (owner and g_side != SIDE_WORN) then
         qty := obj_is_carrying_obj(owner, g_item);
      if (qty < 1) then qty := 1;
      g_rounds := (qty - 1) * get_proto_data(obj_pid(g_item), PROTO_AM_PACK_SIZE)
         + get_object_data(g_item, OBJ_DATA_CUR_CHARGES);
   end
   g_count := qty;
end

procedure describe_side begin
   variable total, slot, weight, ammo, cap, cost;

   total := side_count(g_side);
   if (total <= 0) then begin
      debug_msg("INVEN:none " + g_side + SEP);
      return;
   end

   if (g_index >= total) then g_index := total - 1;
   if (g_index < 0) then g_index := 0;

   g_item := side_item(g_side, g_index);
   call describe_item;

   // An empty worn slot is a legitimate selection -- a free hand is worth
   // knowing about -- so g_item can be 0 here and every engine call below has
   // to survive it. item_weight(0) is exactly the shape that null dereferenced
   // at 0x004AA6AE when gl_world handed obj_can_see_obj a piece of scenery.
   weight := 0;
   if (g_item) then weight := item_weight(g_item);

   // The worn side names its slots, because "nothing" in slot two and
   // "nothing" in slot three are different facts about your hands.
   slot := -1;
   if (g_side == SIDE_WORN) then slot := g_index;

   // The item's own pointer goes on the end, and it is the field that lets the
   // mod stop doing arithmetic. Rows on screen are not in the order this script
   // walks the inventory, so "the third item I listed" and "the third row the
   // engine drew" are different things -- which is why moving one item moved
   // its neighbour. An identity can be matched against what the engine is
   // drawing; a position can only be assumed to line up.
   //
   // Appended rather than inserted: the reader's pattern is not anchored at the
   // end, so an older reader still matches every field it already knew.
   /*
    * And, for a weapon, what is in it.
    *
    * A sighted player sees a green bar beside the weapon on the interface bar
    * and nothing at all beside the ones in their pack -- so this is not
    * reproducing something they have; it is answering the question they answer
    * by picking the gun up and looking at the bar. With three guns in a pack,
    * which one is loaded is otherwise a thing you find out by equipping each
    * of them in turn.
    *
    * Only weapons are asked. get_weapon_ammo_count on a shovel is a question
    * with no answer, and a zero that came from asking the wrong question reads
    * exactly like a zero that means empty.
    *
    * Appended, like the pointer before it: the reader's pattern is not anchored
    * at the end, so a game running last session's compiled script keeps working
    * and simply says nothing about ammunition.
    */
   ammo := -1;
   cap := 0;
   if (g_item and (obj_item_subtype(g_item) == item_type_weapon)) then begin
      ammo := get_weapon_ammo_count(g_item);
      cap := get_proto_data(obj_pid(g_item), PROTO_WP_MAG_SIZE);
   end

   /*
    * What one of it is worth, at face value.
    *
    * A sighted trader finds this out by dragging the thing onto the table and
    * reading the total the engine prints there -- one drag and one glance.
    * Here that was a drag, a wait for the number to be read out, and a drag
    * back, so nobody did it, and the first anyone heard of a thing's value was
    * after it had gone. The proto's cost is the figure the barter totals start
    * from before either side's Barter skill is applied.
    */
   cost := -1;
   if (g_item) then cost := proto_data(obj_pid(g_item), it_cost);

   debug_msg("INVEN:entry " + g_side + SEP + g_index + SEP + total
      + SEP + g_label + SEP + g_count + SEP + weight
      + SEP + slot + SEP + g_item
      + SEP + ammo + SEP + cap + SEP + cost + SEP + g_rounds + SEP);
end

/*
 * announce_open  --  which window, and what is on the far side of it.
 *
 * The container's name is the game's own. Whether it is a pot, a footlocker or
 * a dead radscorpion is the single most useful thing to hear first, and it is
 * the one thing the window makes obvious to everyone else.
 */
procedure announce_open begin
   variable name;

   call load_other;
   name := "";
   if (g_other) then name := obj_name(g_other);

   debug_msg("INVEN:open " + get_game_mode + SEP + name
      + SEP + side_count(SIDE_THEIRS) + SEP + side_count(SIDE_MINE) + SEP);

   /*
    * Where the window actually is, logged and not spoken.
    *
    * Groundwork for moving an item, which needs the pointer put on a specific
    * row. All four windows share one WINTYPE_INVENTORY, so this is measured
    * once and serves the inventory, loot, use-on and barter alike.
    *
    * Reported as x, y, width, height rather than as get_interface_rect's packed
    * form, because four numbers that are each obviously one thing cannot be
    * unpacked in the wrong order.
    */
   debug_msg("INVEN:rect " + get_interface_x(WINTYPE_INVENTORY)
      + SEP + get_interface_y(WINTYPE_INVENTORY)
      + SEP + get_interface_width(WINTYPE_INVENTORY)
      + SEP + get_interface_height(WINTYPE_INVENTORY)
      + SEP + get_interface_id(WINTYPE_INVENTORY)
      + SEP + get_screen_width + "x" + get_screen_height + SEP);
end

/*
 * summarise  --  what you are carrying against what you can carry.
 *
 * The window shows this as "Total Wt: 4/258". The maximum is the engine's own
 * carry-weight stat. The current figure is a sum of the engine's own per-item
 * weights rather than a formula of ours -- there is no call that reports it
 * directly, and adding up numbers the engine gave us is a different thing from
 * inventing a rule about how heavy something is.
 */
/*
 * drop_item  --  the selected item onto the ground, through the engine.
 *
 * Everything the engine's Drop does (0x004736E8), in its order:
 *
 *   a worn item is put back in the pack first, armour taken off properly,
 *   because the open window keeps worn things out of the list;
 *   a live charge sets the engine's flag and goes down as it is;
 *   money is split so ONE pile holding the amount lands, not a coin apiece;
 *   any other stack drops as many as were asked for, one engine call each,
 *   finding the stack again every time -- taking a unit off a stack COPIES
 *   the item for what is left (0x004774E5), so the next unit is a different
 *   object at the same place in the list;
 *   and the window is redrawn the way the engine redraws it after a drop.
 *
 * **How many is asked HERE, not in the engine's window.** Calling that window
 * (0x0047688C) from this keypress hook ran a modal loop inside the hook, so the
 * hook was entered again for every key typed into it while it was still
 * running -- which corrupted it: counts were ignored, and sfall's read_int was
 * handed address 1 and took the game down. So the count is this script's own
 * small prompt, like the item menu: keys in, a number out, nothing modal.
 */
procedure drop_item begin
   variable owner, item, pid, qty, var;

   if (get_game_mode bwand (INTFACELOOT bwor BARTER bwor INTFACEUSE)) then begin
      debug_msg("INVEN:dropnot here" + SEP);
      return;
   end
   if (g_side != SIDE_MINE and g_side != SIDE_WORN) then begin
      debug_msg("INVEN:dropnot here" + SEP);
      return;
   end
   if (get_ini_setting("ddraw.ini|Debugging|AllowUnsafeScripting") <= 0) then begin
      debug_msg("INVEN:dropnot unsafe" + SEP);
      return;
   end
   item := g_item;
   if (not item) then begin
      debug_msg("INVEN:menu gone" + SEP);
      return;
   end
   owner := read_int(INVEN_DUDE);
   if (not owner) then owner := dude_obj;
   pid := obj_pid(item);

   if (g_side == SIDE_WORN) then begin
      var := 0;
      if (read_int(WORN_ARMOR_VAR) == item) then var := WORN_ARMOR_VAR;
      else if (read_int(WORN_LEFT_VAR) == item) then var := WORN_LEFT_VAR;
      else if (read_int(WORN_RIGHT_VAR) == item) then var := WORN_RIGHT_VAR;
      if (not var) then begin
         debug_msg("INVEN:dropnot failed" + SEP);
         return;
      end
      if (var == WORN_ARMOR_VAR) then
         call_offset_v3(F_TAKE_OFF_ARMOR, owner, item, 0);
      call_offset_v3(F_ITEM_ADD_FORCE, owner, item, 1);
      write_int(var, 0);
      call drop_now(owner, item, 1);
      return;
   end

   if (pid == PID_DYNAMITE_LIVE or pid == PID_PLASTIC_LIVE) then begin
      write_int(EXPLOSIVE_DROPPED, 1);
      call drop_now(owner, item, 1);
      return;
   end

   qty := stack_quantity(owner, item);
   if (qty <= 1) then begin
      call drop_now(owner, item, 1);
      return;
   end
   g_dropask := 1;
   g_dropn := 1;
   g_dropmax := qty;
   g_droptyped := 0;
   g_dropitem := item;
   g_dropowner := owner;
   debug_msg("INVEN:dropask" + SEP + obj_name(item) + SEP + g_dropn + SEP
      + g_dropmax + SEP);
end

/*
 * stack_quantity  --  how many are in THIS stack, from the engine's own list.
 *
 * The critter's inventory is at +0x2C: a count, then at +8 a list of
 * (item, quantity) pairs -- the layout item_remove_mult walks (0x0047749F).
 */
procedure stack_quantity(variable owner, variable item) begin
   variable inv, count, list, i;
   inv := owner + 0x2C;
   count := read_int(inv);
   list := read_int(inv + 8);
   i := 0;
   while (i < count and i < 250) do begin
      if (read_int(list + 8 * i) == item) then return read_int(list + 8 * i + 4);
      i := i + 1;
   end
   return 1;
end

procedure drop_ask_report begin
   debug_msg("INVEN:dropcount" + SEP + g_dropn + SEP + g_dropmax + SEP);
end

/*
 * drop_ask_key  --  one key while "drop how many?" is up.
 *
 * Up and Down (and Right and Left) one at a time, ten with Control; Home one,
 * End all; the number row types it; Enter drops, Escape cancels. The same keys
 * the engine's own "Move Items" window answers to, so nothing new to learn.
 */
procedure drop_ask_key(variable key) begin
   variable step, d;

   step := 1;
   if (key_pressed(DIK_LCONTROL) or key_pressed(DIK_RCONTROL)) then step := 10;

   if (key == DIK_ESCAPE) then begin
      g_dropask := 0;
      debug_msg("INVEN:dropnot cancel" + SEP);
      return;
   end
   if (key == DIK_RETURN) then begin
      g_dropask := 0;
      call drop_now(g_dropowner, g_dropitem, g_dropn);
      return;
   end

   d := -1;
   if (key >= DIK_1 and key <= DIK_9) then d := key - DIK_1 + 1;
   else if (key == DIK_0) then d := 0;
   if (d >= 0) then begin
      g_droptyped := g_droptyped * 10 + d;
      if (g_droptyped > g_dropmax) then g_droptyped := g_dropmax;
      if (g_droptyped >= 1) then g_dropn := g_droptyped;
      call drop_ask_report;
      return;
   end

   g_droptyped := 0;
   if (key == DIK_UP or key == DIK_RIGHT) then g_dropn := g_dropn + step;
   else if (key == DIK_DOWN or key == DIK_LEFT) then g_dropn := g_dropn - step;
   else if (key == DIK_HOME) then g_dropn := 1;
   else if (key == DIK_END) then g_dropn := g_dropmax;
   else return;
   if (g_dropn > g_dropmax) then g_dropn := g_dropmax;
   if (g_dropn < 1) then g_dropn := 1;
   call drop_ask_report;
end

/*
 * drop_now  --  drop `n` of `item`, the engine's way. See drop_item.
 */
procedure drop_now(variable owner, variable item, variable n) begin
   variable pid, i, again, name, ok, dropped;

   pid := obj_pid(item);
   name := obj_name(item);
   ok := 1;
   dropped := n;

   if (pid == PID_MONEY_) then begin
      if (n == 1) then begin
         call_offset_v2(F_CAPS_SET_AMOUNT, item, 1);
         call_offset_v2(F_OBJ_DROP, owner, item);
      end else begin
         if (call_offset_r3(F_ITEM_REMOVE_MULT, owner, item, n - 1) != 0) then begin
            ok := 0;
         end else begin
            again := inven_ptr(owner, g_index);
            if (again and obj_pid(again) == PID_MONEY_) then begin
               call_offset_v2(F_CAPS_SET_AMOUNT, again, n);
               call_offset_v2(F_OBJ_DROP, owner, again);
            end else begin
               // Put back what was taken rather than lose it.
               call_offset_v3(F_ITEM_ADD_FORCE, owner, item, n - 1);
               ok := 0;
            end
         end
      end
   end else begin
      i := 0;
      while (i < n) do begin
         again := item;
         if (g_side != SIDE_WORN) then begin
            again := inven_ptr(owner, g_index);
            // The stack ran out, or something else is in its place now.
            if (not again or obj_pid(again) != pid) then begin
               dropped := i;
               i := n;
               again := 0;
            end
         end
         if (again) then call_offset_v2(F_OBJ_DROP, owner, again);
         i := i + 1;
      end
   end

   call inven_redraw;
   // What is left, and what is under the cursor now -- then the verdict last,
   // so that is what is heard.
   call summarise;
   call describe_side;
   if (ok and dropped > 0) then
      debug_msg("INVEN:dropped" + SEP + name + SEP + dropped + SEP);
   else
      debug_msg("INVEN:dropnot failed" + SEP);
end

procedure inven_redraw begin
   call_offset_v1(F_INVEN_CURSOR, 1);
   call_offset_v0(F_DRAW_BODY);
   call_offset_v3(F_DRAW_INVENTORY,
      read_int(INVEN_SCROLL + 4 * read_int(INVEN_STACK_DEPTH)), -1, 0);
end

procedure summarise begin
   variable i, total, carried, item;

   total := inven_size(dude_obj);
   carried := 0;
   i := 0;
   while (i < total) do begin
      item := inven_ptr(dude_obj, i);
      if (item) then carried := carried + item_weight(item);
      i := i + 1;
   end

   debug_msg("INVEN:summary " + get_game_mode + SEP + carried
      + SEP + get_critter_stat(dude_obj, STAT_carry_amt)
      + SEP + total + SEP + side_count(SIDE_THEIRS)
      + SEP + get_inven_ap_cost + SEP);
end

procedure step_item(variable delta) begin
   variable total;
   total := side_count(g_side);
   if (total <= 0) then begin
      debug_msg("INVEN:none " + g_side + SEP);
      return;
   end
   g_index := g_index + delta;
   // Wrap rather than stop. A list you can walk off the end of silently is a
   // list you cannot tell the end of.
   if (g_index >= total) then g_index := 0;
   if (g_index < 0) then g_index := total - 1;
   call describe_side;
end

/*
 * side_usable  --  is this list part of the window that is open?
 *
 * A side is offered when it EXISTS, not when it has anything in it.
 *
 * Skipping empty sides seemed tidy and made the mod unusable in the one case
 * that matters most: unequipping. Take your only weapon out of a hand and the
 * carried list is empty, so the list you need to put it back into is precisely
 * the one that was being skipped -- the equipment panel became a room with no
 * door, and the item could never be taken off.
 *
 * The container side is the only genuinely conditional one: there is no such
 * list in your own inventory window, and offering it would be offering nothing.
 */
procedure side_usable(variable side) begin
   if (side == SIDE_WORN) then return 1;
   if (side == SIDE_MINE) then return 1;
   /*
    * The two offer tables exist only during a barter, and only once the price
    * hook has run and handed them over -- which it does on the way in, before
    * the player can press anything. Testing the pointer rather than the game
    * mode means a table that was never delivered is skipped rather than walked
    * into, and stepping through the lists cannot land on a list that is not
    * there.
    */
   if (side == SIDE_MY_OFFER) then return (g_myoffer != 0);
   if (side == SIDE_THEIR_OFFER) then return (g_theiroffer != 0);
   call load_other;
   if (g_other) then return 1;
   return 0;
end

procedure step_side(variable delta) begin
   variable tries, next;

   tries := 0;
   next := g_side;
   while (tries < SIDES) do begin
      next := next + delta;
      if (next >= SIDES) then next := 0;
      if (next < 0) then next := SIDES - 1;
      if (side_usable(next)) then begin
         g_side := next;
         g_index := 0;
         call describe_side;
         return;
      end
      tries := tries + 1;
   end
   call describe_side;
end

/*
 * on_key  --  the numpad, but only while one of these windows is up.
 *
 * The mode test is the whole reason this can be a separate script. gl_world
 * declines the same keys whenever a panel covers the map, so exactly one of the
 * two acts on any given press and neither has to know about the other.
 */
/*
 * The item menu: the same thing the map's action menu is, for what you carry.
 *
 * The engine does NOT offer a list for inventory items. Holding the button on
 * every carried row and every worn slot in turn left the map's action array
 * reading the last OBJECT it was built for, unchanged -- so unlike the map
 * menu, whose contents come from the engine, this list is the mod's own.
 *
 * That is a real difference and worth stating rather than hiding: this menu can
 * only ever offer what somebody here thought of. It earns its place anyway,
 * because the routes behind it exist and had no keys at all -- "use it" is how
 * an explosive gets armed, and it was previously reachable only by clicking a
 * slot on the interface bar, which is precisely what a blind player cannot do.
 *
 * The script owns the menu because arrows and Enter have to be SWALLOWED while
 * it is up. The ACTIONS belong to the Python side, which can drive the pointer,
 * so Enter writes a line for it to act on rather than doing the work here.
 */
// "Use it" was here, and all it could do was say to put the item in a hand
// first -- the item slot it clicks acts on the active hand only. The U key on
// the map does that job from the hand itself (owner, 0.2.40).
#define IMENU_COUNT     (2)
#define IMENU_DROP      (0)
#define IMENU_LOOK      (1)

procedure worn_slot(variable index) begin
   // The middle column, in the order this script reports it: armour, then the
   // two hands. Same mapping side_item uses; kept as its own procedure so the
   // active-hand test cannot drift away from the list it is testing.
   if (index == 0) then return INVEN_TYPE_WORN;
   if (index == 1) then return INVEN_TYPE_RIGHT_HAND;
   return INVEN_TYPE_LEFT_HAND;
end

procedure imenu_label(variable which) begin
   if (which == IMENU_DROP) then return "drop it";
   if (which == IMENU_LOOK) then return "look at it";
   return "action " + which;
end

procedure imenu_open begin
   if (not g_item) then begin
      debug_msg("INVEN:menu none" + SEP);
      return;
   end
   g_imenu := 1;
   g_imenu_index := 0;
   debug_msg("INVEN:menu open" + SEP + g_label + SEP + IMENU_COUNT
      + SEP + imenu_label(0) + SEP);
end

procedure imenu_close begin
   g_imenu := 0;
   g_imenu_index := 0;
end

procedure imenu_step(variable delta) begin
   variable next;

   next := g_imenu_index + delta;
   // Clamped, not wrapped: a list you can walk off the end of without noticing
   // is one you will act from without meaning to.
   if (next < 0) then next := 0;
   if (next >= IMENU_COUNT) then next := IMENU_COUNT - 1;
   g_imenu_index := next;
   debug_msg("INVEN:menu at" + SEP + imenu_label(g_imenu_index) + SEP
      + (g_imenu_index + 1) + SEP + IMENU_COUNT + SEP);
end

procedure imenu_do begin
   variable which, active;

   which := g_imenu_index;
   call imenu_close;
   if (not g_item) then begin
      debug_msg("INVEN:menu gone" + SEP);
      return;
   end

   /*
    * Look is answered here and goes no further.
    *
    * Every other entry on this list ends in a pointer: "use it" is a click on
    * the interface bar's item slot, "drop it" is a drag onto the character.
    * A description needs none of that -- it is a string the engine is already
    * holding -- so it is read and spoken without anything being aimed, which
    * makes it the one action on this menu that cannot land on the wrong thing.
    *
    * The words are the game's own, out of the item's prototype, so a
    * translated game reads out translated and no English is shipped here.
    *
    * Reported alongside the name rather than instead of it: "look at it" on a
    * list you navigated by name should confirm which name it answered for,
    * because the list cursor can be moved between opening the menu and
    * choosing from it.
    */
   if (which == IMENU_DROP) then begin
      call drop_item;
      return;
   end
   if (which == IMENU_LOOK) then begin
      debug_msg("INVEN:look" + SEP + g_label + SEP
         + proto_data(obj_pid(g_item), it_description) + SEP);
      return;
   end
   /*
    * The side and index go with it, because by the time the other side acts on
    * this the list cursor may have been moved.
    *
    * So does whether this item is the ACTIVE one. critter_inven_obj answers
    * only for the active hand -- ask it about the other and it says nothing --
    * which makes it useless as a reading and exact as this test. The Python
    * side needs it because "use it" ends in a click on the interface bar's item
    * slot, and that slot acts on the active item: clicking it with a WEAPON
    * live attacks instead, which is how a fight started and a charge got
    * dropped during development.
    */
   active := 0;
   if (g_side == SIDE_WORN) then begin
      if (critter_inven_obj(dude_obj, worn_slot(g_index)) == g_item) then
         active := 1;
   end
   debug_msg("INVEN:do" + SEP + imenu_label(which) + SEP + g_label
      + SEP + g_side + SEP + g_index + SEP + side_count(g_side)
      + SEP + active + SEP);
end

procedure on_key begin
   variable event, key, act, pressed;

   event := get_sfall_arg;
   key := get_sfall_arg;
   // The release is swallowed alongside the press -- see KEY_SWALLOW. Dropping
   // it here left the engine holding half of every key this script took.
   pressed := (event == 1);
   if (not (get_game_mode bwand INVEN_MODES)) then return;
   /*
    * Stand down while the quantity window is up.
    *
    * It is drawn over the inventory and the inventory's own mode bit stays
    * set underneath it, so without this the arrows would walk the list behind
    * a window the player is typing a number into -- and would be swallowed on
    * the way, so the window would not get them either. That is the same
    * "whichever script claims the mode owns the keyboard" rule the four
    * scripts already share, applied to a window none of them owns.
    *
    * It only became reachable when the arrows were bound here. The numpad
    * digits this handler used to take are not keys that window wants.
    */
   if (get_game_mode bwand COUNTERWIN) then return;

   /*
    * The item menu owns the keyboard while it is up, and these keys must be
    * SWALLOWED or the inventory window acts on them underneath the menu.
    */
   if (g_dropask) then begin
      if (pressed) then call drop_ask_key(key);
      set_sfall_return(KEY_SWALLOW);
      return;
   end

   if (g_imenu) then begin
      if (key == DIK_UP) then begin
         if (pressed) then call imenu_step(-1);
         set_sfall_return(KEY_SWALLOW);
         return;
      end
      if (key == DIK_DOWN) then begin
         if (pressed) then call imenu_step(1);
         set_sfall_return(KEY_SWALLOW);
         return;
      end
      if (key == DIK_RETURN) then begin
         if (pressed) then call imenu_do;
         set_sfall_return(KEY_SWALLOW);
         return;
      end
      if (key == DIK_ESCAPE) then begin
         if (pressed) then call imenu_close;
         debug_msg("INVEN:menu closed" + SEP);
         set_sfall_return(KEY_SWALLOW);
         return;
      end
   end

   /*
    * Enter moves the selected item: once to pick it up, once where it goes.
    *
    * It was numpad plus, which is the mouse button on the map and nowhere
    * else now (fallout2_access/controls.py). Taken here rather than by the
    * Python side because only this script knows whether its item menu is up,
    * and Enter there means "do the menu entry" -- that case returned above.
    */
   if (key == DIK_RETURN) then begin
      if (pressed) then debug_msg("INVEN:enter" + SEP);
      set_sfall_return(KEY_SWALLOW);
      return;
   end

   /*
    * Numpad dot opens the item menu, read straight off the keyboard.
    *
    * It was reached by the Python side synthesising an M, the same round trip
    * gl_world.ssl has just stopped doing, and with the same fault: a queued
    * hotkey only runs on a tick where the screen detection has settled, and is
    * discarded without a sound after a second. The map's menu is where that was
    * noticed, but nothing about the bug was particular to the map -- this list
    * was reached the same way and could be lost the same way.
    *
    * M is kept here, unlike on the map. There it had to go because the manual
    * gives it the mouse mode toggle; in an inventory panel there is no mouse
    * mode to toggle, so holding onto it costs the player nothing and leaves a
    * second way in for anyone who has learned it.
    */
   if (key == DIK_DECIMAL or key == DIK_M) then begin
      call imenu_open;
      set_sfall_return(KEY_SWALLOW);
      return;
   end

   /*
    * The engine's own list keys, watched and deliberately NOT swallowed.
    *
    * The manual documents Home, End, Page Up and Page Down as scrolling the
    * inventory lists. If they really do, then reaching a given row needs no
    * memory address at all: press Home and the list is at the top, press Page
    * Down a known number of times and it is at a known place. The scroll
    * position becomes something we CAUSED rather than something we have to go
    * and read out of the engine.
    *
    * That is worth a great deal here. Every absolute address in this project is
    * a portability liability -- they are confirmed against one retail build and
    * are the reason this does not yet run on GOG. A method built out of keys
    * the manual documents has no address in it and cannot drift.
    *
    * So: log them, pass them through, and let the next session say whether the
    * engine acts on them. If it does, the scroll hunt is unnecessary.
    */
   if (key == DIK_HOME or key == DIK_END
       or key == DIK_PRIOR or key == DIK_NEXT) then begin
      debug_msg("INVEN:listkey " + key + SEP + g_side + SEP
         + side_count(g_side) + SEP);
      return;          // no set_sfall_return: the window must still see it
   end

   /*
    * The arrows, and the numpad that is no longer here.
    *
    * Up and down step the item, left and right step the list. That is the
    * whole player-facing keyboard of this window now.
    *
    * The numpad used to do this and does not any more, and keeping it "because
    * it costs one line" was the wrong answer: the digits were never a design,
    * they were an inheritance. The numpad is the hex cursor's keyboard because
    * a map has six directions and no north, and a list has two -- so these two
    * windows were the only screens in the mod asking a player to move their
    * hand for a job the arrows do everywhere else. Leaving both bound would
    * have left that on the table and called it kindness.
    *
    * Re-reading the selected item did not need a key of its own either: numpad
    * slash is the mod's repeat key on every screen it has, and in this window
    * it already says the selected item. That is what numpad 5 was for.
    *
    * **Numpad 0 is the exception, and it is not a player key.** It makes the
    * script report the totals, and the mod presses it itself after moving an
    * item -- it is the only way to ask this script anything, since a keypress
    * is the one channel there is. Nothing tells a player to press it. A player
    * who does gets the totals, which is a fair answer to an accidental press.
    *
    * The arrows are swallowed like everything else this handler claims. The
    * manual gives the inventory lists Home, End, Page Up and Page Down and
    * says nothing about arrows, and those four are passed through untouched
    * just above -- so what is taken here is a key the window was not using.
    */
   act := 0;
   if      (key == DIK_UP)    then act := 1;
   else if (key == DIK_DOWN)  then act := 2;
   else if (key == DIK_LEFT)  then act := 3;
   else if (key == DIK_RIGHT) then act := 4;
   else if (key == DIK_NUMPAD0) then act := 6;   // the mod asking, not a player
   else return;

   // The key is ours. The release is swallowed and does nothing; acting on it
   // as well would step every list twice per press.
   if (not pressed) then begin
      set_sfall_return(KEY_SWALLOW);
      return;
   end

   // Log arrival before doing any work, so that if a call in here ever takes
   // the engine down, the last line written names the key that did it.
   debug_msg("INVEN:key " + key + " act " + act + SEP);

   if      (act == 1) then call step_item(-1);
   else if (act == 2) then call step_item(1);
   else if (act == 3) then call step_side(-1);
   else if (act == 4) then call step_side(1);
   else if (act == 6) then call summarise;

   // Swallowed: the arrows are ours while this window is up, and so is the
   // numpad 0 the mod presses itself.
   set_sfall_return(KEY_SWALLOW);
end

/*
 * on_barterprice  --  report what the barter is worth, in the engine's numbers.
 *
 * The barter screen prints two totals: what the goods you are asking for come
 * to, and what the goods you are offering come to. A sighted player watches
 * those two numbers and adds items until they balance. They are the whole game
 * of bartering, and they were the one thing this mod could not say.
 *
 * **They are not anywhere to be read.** That was established the expensive way:
 * an item was moved into an offer table and every four-byte value in the
 * executable's static data was compared before and after. Nothing held a price.
 * The engine computes the totals inside the routine that draws them and keeps
 * nothing, so there is no address to point at.
 *
 * Which leaves two options, and only one of them is honest. The formula is
 * documented -- cost, doubled, scaled by the two barter skills -- and the mod
 * could work the numbers out for itself. It does not, because a number this mod
 * calculated is a number that can disagree with the one on screen, and a player
 * who cannot see the screen would have no way to catch it. Every skill, perk,
 * trait and content mod that touches a price would have to be reimplemented
 * here and kept in step for ever.
 *
 * So the number is taken from the engine at the moment the engine works it out.
 * sfall runs this hook inside that calculation and hands over its arguments,
 * which include both totals. We read them and pass them on.
 *
 * **Nothing is returned, deliberately.** The hook exists so that a mod can
 * CHANGE a price -- that is what ret0 and ret1 are for -- and setting either
 * would make this mod an economy mod. Leaving both unset is what makes this a
 * measurement rather than an intervention, and it is the same line the rest of
 * the project draws: no hook that could change the outcome, even where the
 * engine offers one.
 *
 * The hook fires twice on entering the screen, once for each side, and again
 * after every change. That is fine -- the Python half reports a total only when
 * it differs from the last one it heard.
 */
procedure on_barterprice begin
   variable who, with_whom, base, caps, before_skill, offered, pressed, party;

   who := get_sfall_arg;          // arg0  the critter doing the bartering
   with_whom := get_sfall_arg;    // arg1  the critter being bartered with
   base := get_sfall_arg;         // arg2  the value of the goods requested
   g_theiroffer := get_sfall_arg; // arg3  the table of requested goods
   caps := get_sfall_arg;         // arg4  actual caps in the barter stack
   before_skill := get_sfall_arg; // arg5  value before skill modifications
   g_myoffer := get_sfall_arg;    // arg6  the table of offered goods
   offered := get_sfall_arg;      // arg7  total cost of what the player offers
   pressed := get_sfall_arg;      // arg8  1 if the offers button was pressed
   party := get_sfall_arg;        // arg9  1 if trading with a party member

   /*
    * Both sides on one line, so the Python half never has to pair up two
    * reports that arrived separately. `base` is what the goods being bought
    * come to after the barter skills are applied, which is the figure on
    * screen; `before_skill` is the same goods at face value, and the gap
    * between them is what the player's Barter skill is worth. A sighted player
    * sees only the first, so the second is reported and not spoken.
    */
   debug_msg("INVEN:price " + base + SEP + offered + SEP + caps
      + SEP + before_skill + SEP + pressed + SEP + party + SEP);

   /*
    * `pressed` is the reason this hook can report a trade at all.
    *
    * There is an "offer" control on the barter screen and it is not a button
    * GNW knows about: the window's whole button list was read live and it
    * holds four item panes, eight scroll arrows, two container-drill buttons
    * and Talk. Every plausible key was tried against a staged trade -- m, o,
    * Enter, space, b -- and the engine did nothing and said nothing. Whatever
    * the control is, it is not reachable by the routes this mod can enumerate.
    *
    * sfall knows, though: it sets this argument when the offer is what caused
    * the price to be recalculated. So the moment a player presses whatever it
    * really is, this line says so -- which turns a hunt through a disassembly
    * into one observation from someone who can see the screen.
    */

   /*
    * The tables are the other half of what this hook is for, and the more
    * important half. arg3 and arg6 are the two temporary objects the barter
    * screen keeps its offers in, and this is the only place the engine ever
    * names them -- there is no script function that asks for them and no
    * address that survives a second barter. Catching them here is what turns
    * the two middle panes from invisible into two more lists the numpad walks.
    *
    * Which is which is worth stating, because the names read backwards at
    * first glance. arg3 is the "requested" goods -- what is being bought FROM
    * the shopkeeper -- which is the pile on their side of the table. arg6 is
    * "offered" -- what the player is putting up. Getting them the wrong way
    * round would swap the two panes and describe every trade backwards.
    */
end
