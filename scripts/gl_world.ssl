/*
 * gl_world.ssl  --  a virtual hex cursor for exploring the map by ear.
 *
 * Fallout 2 has no keyboard movement, and a blind player cannot point at a
 * hex. This puts a cursor on the map that the numpad walks around one hex at
 * a time, announcing what is on each. The six directions map onto the numpad's
 * corners and sides, because a hex has six neighbours and no north or south:
 *
 *        7 NW   9 NE
 *      4 W          6 E          5 = re-read current hex
 *        1 SW   3 SE             8 = snap cursor back to the player
 *
 * Hex arithmetic is left entirely to tile_num_in_direction. Neighbour offsets
 * are parity-dependent -- from tile 17488 they are NE-1, E+199, SE+200, SW+201,
 * W+1, NW-200, and they differ on the next row -- so reimplementing them by
 * hand is a bug farm. We ask the engine.
 *
 * STATUS: diagnostic pass. Two crashes so far, both instructive:
 *   1. free_array() on the temp array from tile_get_objs -- sfall auto-deletes
 *      temporary arrays at end of frame, so that was a double free.
 *   2. A null dereference at 0x004AA6AE reading [0x15C], reached from inside
 *      this procedure. obj_can_see_obj is the prime suspect: it is documented
 *      to do perception and stealth rolls "if the objects are critters", and
 *      tile_get_objs returns scenery and walls too.
 * So this version calls NO visibility function at all. It logs what is
 * actually on a hex, with object types, so the visibility policy can be
 * chosen against real data instead of guesswork. Every step traces before it
 * runs: the last line printed names whatever kills it.
 *
 * Output goes to debug.log as "WORLD:..." lines. Requires DebugMode=2.
 *
 * Compile from data/scripts (two steps -- packaged compiler preprocessor bug):
 *   compile.exe -P gl_world.ssl
 *   compile.exe gl_world.preprocessed.ssl -o gl_world.int
 */

#include "sfall/sfall.h"
#include "sfall/dik.h"
// define_lite.h is needed only for tile_set_center, which is a metarule3
// macro rather than a builtin opcode like the rest of what we call here.
#include "sfall/define_lite.h"
// define_extra.h carries the OBJ_TYPE_* constants.
#include "sfall/define_extra.h"

// Game modes that put a panel over the map. get_game_mode is a bitmask, so
// membership is tested with bwand rather than equality. LOCALMAP, COMBAT and
// PCOMBAT are deliberately absent: none of them hides the world.
#define MAP_HIDDEN (WORLDMAP bwor DIALOG bwor ESCMENU bwor SAVEGAME bwor \
                    LOADGAME bwor OPTIONS bwor HELP bwor CHARSCREEN bwor \
                    PIPBOY bwor INVENTORY bwor AUTOMAP bwor SKILLDEX bwor \
                    INTFACEUSE bwor INTFACELOOT bwor BARTER bwor HEROWIN bwor \
                    DIALOGVIEW bwor COUNTERWIN bwor PAUSEWIN)

#define CURSOR_UNSET        (-1)

#define DIR_NE              (0)
#define DIR_E               (1)
#define DIR_SE              (2)
#define DIR_SW              (3)
#define DIR_W               (4)
#define DIR_NW              (5)

#define ACT_DESCRIBE        (-2)
#define ACT_SNAP            (-3)
#define ACT_CALIB           (-4)
#define ACT_MOVEMODE        (-5)
#define ACT_SCAN_TYPENEXT   (-6)
#define ACT_SCAN_TYPEPREV   (-7)
#define ACT_SCAN_CATNEXT    (-8)
#define ACT_SCAN_CATPREV    (-9)
#define ACT_SCAN_INSTNEXT  (-10)
#define ACT_SCAN_INSTPREV  (-11)
#define ACT_SCAN_JUMP      (-12)
#define ACT_PREPARE        (-13)
#define ACT_NORTH          (-14)
#define ACT_SOUTH          (-15)

variable g_cursor := CURSOR_UNSET;
variable g_lastmode := -1;
variable g_lastcursormode := -1;
variable g_lastdude := -1;
variable g_lastbtn := -1;
variable g_lastunder := -1;
variable g_hascritter := 0;
variable g_hasobject := 0;
variable g_scan_cat := 0;
variable g_scan_type := 0;
variable g_scan_inst := 0;
variable g_restore_ticks := 0;
variable g_playercursor := 0;
variable g_armedskill := 0;
// Which way the north/south staircase currently leans. See step_north.
variable g_ndrift := 0;
variable g_label := "";
variable g_movestart := -1;
variable g_moving := 0;
variable g_stillticks := 0;

procedure start;
procedure map_enter_p_proc;
procedure on_key;
procedure poll_state;
procedure recenter_view;
procedure describe_cursor;
procedure step_cursor(variable dir);
procedure snap_to_dude;
procedure step_north;
procedure step_south;
procedure calibrate;
procedure force_action_cursor;
procedure live_critter_at_cursor;
procedure obj_label(variable obj);
procedure scan_list_type(variable cat);
procedure scan_keep(variable obj);
procedure scan_do(variable level, variable dojump);
procedure scan_instance(variable delta);
procedure scan_type(variable delta);
procedure scan_category(variable delta);
procedure scan_jump;
procedure prepare_cursor;
procedure on_useskill;

/*
 * start  --  init once, then poll.
 *
 * `game_loaded` is true on the FIRST call after a load and never again, so
 * this splits cleanly: the true branch sets up, the false branch is the
 * periodic poll. That split only works because the keypress hook now goes to
 * its own procedure via register_hook_proc. With the bare register_hook, the
 * hook is delivered to `start` itself and lands in the else branch, which
 * makes the else branch mean two different things and rules out polling
 * entirely.
 *
 * That was a silent, load-bearing bug: without set_global_script_repeat this
 * script ran `start` exactly ONCE per session. Every "emit when it changes"
 * watcher below was dead code -- a whole session's debug.log contains exactly
 * one WORLD:gamemode line and not a single automatic WORLD:cursormode. So the
 * game mode was never re-reported after the first frame, and the cursor mode
 * was only ever heard when numpad 0 was pressed explicitly. It looked like the
 * watchers were working because the one line they emit at startup is the one
 * the Python side needs to detect a live session.
 */
procedure start begin
   if game_loaded then begin
      set_global_script_type(1);   // run wherever the cursor is visible
      set_global_script_repeat(2); // ~30 polls/sec; fast enough to catch a click
      register_hook_proc(HOOK_KEYPRESS, on_key);
      register_hook_proc(HOOK_USESKILLON, on_useskill);
      g_cursor := tile_num(dude_obj);
      g_lastdude := g_cursor;
      // Print a beacon into the interface bar's display window. The Python
      // side finds it by searching memory for this exact text, which is how it
      // learns where that buffer lives -- it is heap-allocated and moves every
      // launch, and there is no static pointer to it anywhere in the exe.
      //
      // Planting our own landmark beats hunting for the buffer's shape: empty
      // heap looks just like an empty message record, so a structural search
      // finds hundreds of false positives. This finds exactly one thing.
      display_msg("Access Never Changes ready.");
      debug_msg("WORLD:ready");
   end else begin
      call poll_state;
   end
end

/*
 * poll_state  --  watch the states that change without a keypress.
 *
 * Everything here emits only on change, so debug.log stays readable and the
 * Python side can speak the ones that matter without heartbeat chatter.
 *
 * The map-specific reads are gated on game mode 0 (the plain map view). On the
 * world map or behind an open panel, the hex and mouse functions have nothing
 * sensible to report, and this script has hard-crashed the engine twice
 * already by calling a function on something it did not expect.
 */
procedure poll_state begin
   variable m, c, d, b;

   // Game mode. This is the ONLY reliable way for the Python side to know we
   // are in a loaded game and which sub-screen is up: from memory alone, being
   // in the world looks identical to sitting on the premade-character screen,
   // so the mod was announcing "character selection" while the player stood on
   // a map.
   m := get_game_mode;
   if (m != g_lastmode) then begin
      g_lastmode := m;
      debug_msg("WORLD:gamemode " + m);
   end

   // Cursor mode decides what a left click MEANS -- walk, interact, aim, or
   // use a skill -- and a sighted player reads that off the cursor art
   // continuously. It can also change without the player doing anything they
   // would connect to it: a skill armed from the Skilldex stays armed.
   // Undo our own scroll-cursor side effect, on a short retry window rather
   // than immediately. Restoring inside recenter_view did not work: the engine
   // applies the directional scroll cursor a frame or two AFTER tile_set_center
   // returns, so the restore landed first and was promptly overwritten.
   //
   // Nothing is announced while this window is open. The player did not ask for
   // the mode change and never needed to know it happened -- saying "cursor
   // mode 8" after every single hex step was pure noise generated by the mod
   // about the mod.
   c := get_cursor_mode;
   if (g_restore_ticks > 0) then begin
      g_restore_ticks := g_restore_ticks - 1;
      if (c != g_playercursor) then begin
         set_cursor_mode(g_playercursor);
         c := get_cursor_mode;
      end
      g_lastcursormode := c;
   end else if (c != g_lastcursormode) then begin
      // Nothing of ours is in flight, so this is the player's own doing -- a
      // Skilldex key, a right click. Remember it as what to restore to.
      g_lastcursormode := c;
      g_playercursor := c;
      debug_msg("WORLD:cursormode " + c);
   end

   // Map telemetry is meaningful whenever the map is actually visible, which
   // includes combat. get_game_mode is a BITMASK and several bits can be set at
   // once -- during the player's own turn it reads 0x840, COMBAT *and*
   // PCOMBAT -- so this has to be a mask test. Two earlier versions compared it
   // for equality (`m != 0`, then `m != 0 and m != COMBAT`) and both switched
   // every watcher below off for the whole of every fight, which is exactly
   // when they matter most.
   if (m bwand MAP_HIDDEN) then return;

   // Did the player actually move, and have they finished?
   //
   // A walk arrives one tile at a time, so announcing each tile babbles
   // through a long journey -- twelve "moved 1 hex" in a row, which is what a
   // timer-based version produced. The engine knows the answer exactly:
   // anim_busy is true while the player is animating. A short stillness
   // counter guards against the gap between one step's animation and the
   // next being read as an arrival.
   d := tile_num(dude_obj);
   if (d != g_lastdude) then begin
      if (not g_moving) then begin
         g_movestart := g_lastdude;
         g_moving := 1;
      end
      g_lastdude := d;
      g_stillticks := 0;
      debug_msg("WORLD:dude " + d + "|");
   end

   if (g_moving) then begin
      if (anim_busy(dude_obj)) then begin
         g_stillticks := 0;
      end else begin
         g_stillticks := g_stillticks + 1;
         if (g_stillticks >= 10) then begin
            g_moving := 0;
            g_stillticks := 0;
            debug_msg("WORLD:arrive " + d + " dist "
               + tile_distance(g_movestart, d) + "|");
         end
      end
   end

   // Which hex the pointer is actually over. Logged on change because of a
   // result that still makes no sense: across a whole session this stayed
   // pinned at 17890 while the view was recentred on several different hexes
   // and the pointer never moved. If the view really scrolls under a fixed
   // pointer, this MUST change. Either tile_set_center is not scrolling (the
   // map may be clamped at its edges), or this value is stale. Until that is
   // settled, aiming a click at a chosen hex is guesswork.
   variable u;
   u := tile_under_cursor;
   if (u != g_lastunder) then begin
      g_lastunder := u;
      // dist is the objective function for aiming: the pointer has to be
      // walked onto the look cursor, and hex geometry is parity-dependent and
      // not worth reimplementing. With a distance to minimise, the mouse can be
      // servoed by feedback instead of by arithmetic.
      debug_msg("WORLD:under " + u + " look=" + g_cursor
         + " dist " + tile_distance(u, g_cursor) + " dude=" + d);
   end

   // Mouse buttons, sampled continuously rather than on demand. This is the
   // measurement the click investigation has been missing for two sessions:
   // calibration only ran when numpad 2 was pressed, and nobody can press
   // numpad 2 at the same instant as the click being diagnosed. Emitting a
   // full snapshot on every button transition answers, in one line, all three
   // open questions -- did the engine see the button, where was the pointer
   // actually pointing, and was it over the map or the interface bar.
   b := get_mouse_buttons;
   if (b != g_lastbtn) then begin
      g_lastbtn := b;
      debug_msg("WORLD:btn " + b
         + " under=" + tile_under_cursor
         + " win=" + get_window_under_mouse
         + " bar=" + get_interface_id(WINTYPE_IFACEBAR)
         + " cursor=" + c
         + " dude=" + d
         + " look=" + g_cursor
         + " mouse=" + get_mouse_x + "," + get_mouse_y);
   end
end

/*
 * map_enter_p_proc  --  a new map invalidates everything positional.
 *
 * Tile numbers are per-map, so nothing measured on the old one carries over.
 * Two things went wrong on the first map change: walking through an exit grid
 * was announced as "moved 74 hexes", because the arrival distance was measured
 * between two tiles on different maps; and the look cursor kept pointing at a
 * tile number from the map just left, so it was somewhere arbitrary until the
 * player happened to press numpad 8.
 *
 * Everything positional is therefore reseeded here, and the pending arrival is
 * cancelled so the transition is not reported as a walk.
 */
procedure map_enter_p_proc begin
   g_cursor := tile_num(dude_obj);
   g_lastdude := g_cursor;
   g_moving := 0;
   g_stillticks := 0;
   g_lastunder := -1;
   debug_msg("WORLD:map " + g_cursor + " elev " + elevation(dude_obj));
end

procedure on_key begin
   variable event := get_sfall_arg;
   variable key   := get_sfall_arg;
   if (event != 1) then return;          // key-up: ignore

   // The Skilldex number keys, observed but not swallowed -- the game still
   // needs them to arm the skill. We only record WHICH, because reading the
   // world clobbers the cursor and it has to be put back to the player's
   // intention before a click, not to whatever the engine last decided.
   // Measured mapping; Sneak is a toggle with no cursor of its own.
   if (key == DIK_1) then begin g_armedskill := 0;  return; end   // Sneak
   if (key == DIK_2) then begin g_armedskill := 6;  return; end   // Lockpick
   if (key == DIK_3) then begin g_armedskill := 7;  return; end   // Steal
   if (key == DIK_4) then begin g_armedskill := 8;  return; end   // Traps
   if (key == DIK_5) then begin g_armedskill := 4;  return; end   // First Aid
   if (key == DIK_6) then begin g_armedskill := 5;  return; end   // Doctor
   if (key == DIK_7) then begin g_armedskill := 9;  return; end   // Science
   if (key == DIK_8) then begin g_armedskill := 10; return; end   // Repair

   variable dir := -1;
   if      (key == DIK_NUMPAD9) then dir := DIR_NE;
   else if (key == DIK_NUMPAD6) then dir := DIR_E;
   else if (key == DIK_NUMPAD3) then dir := DIR_SE;
   else if (key == DIK_NUMPAD1) then dir := DIR_SW;
   else if (key == DIK_NUMPAD4) then dir := DIR_W;
   else if (key == DIK_NUMPAD7) then dir := DIR_NW;
   else if (key == DIK_NUMPAD8) then dir := ACT_NORTH;
   else if (key == DIK_NUMPAD2) then dir := ACT_SOUTH;
   else if (key == DIK_NUMPAD5) then dir := ACT_SNAP;
   // Calibration is the aimer's own business, pressed several times per click
   // and never by a player, so it sits on a key nobody reaches for.
   else if (key == DIK_APOSTROPHE) then dir := ACT_CALIB;
   else if (key == DIK_NUMPAD0) then dir := ACT_MOVEMODE;
   // The brackets carry all three scanner levels, chosen so the frequent
   // action needs no modifier at all:
   //     [ ]         the type of thing -- torches, rocks, ants
   //     shift [ ]   which one of that type
   //     ctrl  [ ]   the category -- critters, items, scenery
   // key_pressed reads the live keyboard, which is why modifiers work from
   // inside a keypress hook.
   else if (key == DIK_LBRACKET) then begin
      if (key_pressed(DIK_LCONTROL) or key_pressed(DIK_RCONTROL)) then
         dir := ACT_SCAN_CATPREV;
      else if (key_pressed(DIK_LSHIFT) or key_pressed(DIK_RSHIFT)) then
         dir := ACT_SCAN_INSTPREV;
      else
         dir := ACT_SCAN_TYPEPREV;
   end
   else if (key == DIK_RBRACKET) then begin
      if (key_pressed(DIK_LCONTROL) or key_pressed(DIK_RCONTROL)) then
         dir := ACT_SCAN_CATNEXT;
      else if (key_pressed(DIK_LSHIFT) or key_pressed(DIK_RSHIFT)) then
         dir := ACT_SCAN_INSTNEXT;
      else
         dir := ACT_SCAN_TYPENEXT;
   end
   else if (key == DIK_SLASH) then dir := ACT_SCAN_JUMP;
   else if (key == DIK_BACKSLASH) then dir := ACT_PREPARE;
   else return;

   // Log arrival before doing any work. When this crashed the engine,
   // nothing had been written, leaving it ambiguous whether the key had
   // even been delivered. Now that is always answerable.
   debug_msg("WORLD:key " + key + " dir " + dir);

   if      (dir == ACT_NORTH)    then call step_north;
   else if (dir == ACT_SOUTH)    then call step_south;
   else if (dir == ACT_SNAP)     then call snap_to_dude;
   else if (dir == ACT_DESCRIBE) then call describe_cursor;
   else if (dir == ACT_CALIB)    then call calibrate;
   else if (dir == ACT_MOVEMODE) then call force_action_cursor;
   else if (dir == ACT_SCAN_TYPENEXT) then call scan_type(1);
   else if (dir == ACT_SCAN_TYPEPREV) then call scan_type(-1);
   else if (dir == ACT_SCAN_INSTNEXT) then call scan_instance(1);
   else if (dir == ACT_SCAN_INSTPREV) then call scan_instance(-1);
   else if (dir == ACT_SCAN_CATNEXT)  then call scan_category(1);
   else if (dir == ACT_SCAN_CATPREV)  then call scan_category(-1);
   else if (dir == ACT_SCAN_JUMP)     then call scan_jump;
   else if (dir == ACT_PREPARE)       then call prepare_cursor;
   else                               call step_cursor(dir);

   set_sfall_return(0);   // swallow the key so the game does not also act
end

procedure step_cursor(variable dir) begin
   variable next := tile_num_in_direction(g_cursor, dir, 1);
   if (next > 0) then begin
      g_cursor := next;
   end
   // Scroll the view so the cursor hex sits at the centre of the viewport.
   // Deliberate: with the cursor always dead centre, the Python side can later
   // click it by moving the mouse to one fixed screen point, with no
   // tile-to-screen arithmetic to get subtly wrong.
   call recenter_view;
   call describe_cursor;
end

/*
 * recenter_view  --  scroll to the look cursor WITHOUT wrecking the mouse mode.
 *
 * tile_set_center changes the cursor mode as a side effect: the engine swaps in
 * a directional scroll cursor, and it stays there. Live logs show the mode
 * tracking the direction just moved (W gives 8, E gives 5, SE 7, NW 9), and a
 * click in that state does not walk the player.
 *
 * That side effect made click testing impossible without anyone realising:
 * pressing numpad 0 to force the movement cursor and then stepping one hex to
 * pick a target put the cursor straight back into a scroll mode before the
 * click ever happened. Every click test so far has been run in the wrong mode.
 *
 * So the mode is saved and put back. Only 0-2 are restored verbatim; anything
 * else is a state we did not ask for and did not choose, so it collapses to the
 * movement cursor rather than being preserved.
 */
procedure recenter_view begin
   // Scrolling changes the cursor too; poll_state restores the player's own.
   tile_set_center(g_cursor);
   // The engine sets the scroll cursor a frame or two later, so it cannot be
   // put back here -- poll_state cleans it up over the next few ticks instead.
   g_restore_ticks := 8;
end

/*
 * calibrate  --  groundwork for clicking a hex.
 *
 * Movement in Fallout 2 is click-only, so eventually the mouse must land on
 * the cursor hex. tile_set_center already parks that hex at the centre of the
 * world viewport, but the viewport's centre in *screen* pixels is unknown --
 * the interface bar eats the bottom of the window, and HRP has moved things.
 *
 * Rather than derive it (and risk clicks landing one hex off, the exact error
 * a blind player cannot catch), we ask the engine: put the mouse somewhere,
 * and tile_under_cursor says which hex it is actually over. When that matches
 * g_cursor, the screen point is right and a click is safe.
 */
procedure calibrate begin
   variable mx, my, under, btns, winid, barid, ou, ouname;
   mx := get_mouse_x;
   my := get_mouse_y;
   under := tile_under_cursor;

   // Which window is the pointer actually over? There is no WINTYPE_* for the
   // map view -- the world is what is left when no interface window claims the
   // point -- so "over the map" is established by the id NOT matching the
   // interface bar. This matters because tile_under_cursor will happily report
   // a hex while the pointer sits on the interface bar, which would make a
   // click that pressed a UI button look like a click the map ignored.
   winid := get_window_under_mouse;
   barid := get_interface_id(WINTYPE_IFACEBAR);
   debug_msg("WORLD:win under=" + winid + " ifacebar=" + barid
      + " onbar=" + (winid == barid)
      + " barrect=" + get_interface_x(WINTYPE_IFACEBAR) + ","
      + get_interface_y(WINTYPE_IFACEBAR) + " "
      + get_interface_width(WINTYPE_IFACEBAR) + "x"
      + get_interface_height(WINTYPE_IFACEBAR));
   // Game mode and cursor mode were the two states that made clicks look
   // broken: with the Skilldex panel open the game consumes clicks, and
   // right-click toggles the cursor between movement and command, so a left
   // click may interact instead of walk. Both are now visible rather than
   // guessed at.
   debug_msg("WORLD:mode game=" + get_game_mode + " cursor=" + get_cursor_mode);
   // buttons: synthetic motion demonstrably reaches the game, but a synthetic
   // click produced no reaction even with focus and hex lock both verified.
   // This reports whether the engine sees the button at all, which separates
   // "the click never arrived" from "it arrived and the game declined to act".
   // (Prime suspect is now the third possibility: it arrived, and acted -- as a
   //  skill use, because the cursor was armed from the Skilldex.)
   btns := get_mouse_buttons;
   // What the engine thinks a click would act on, in ANY cursor mode.
   // HOOK_TARGETOBJECT only fires for the combat targeting cursor; this works
   // for walking, interacting and skills alike, so one aim routine serves them
   // all instead of a special case per kind of click.
   // obj_under_cursor CHANGES THE ACTION CURSOR as a side effect -- asking the
   // engine what is under the pointer makes it decide what a click there would
   // do, and it leaves that decision behind. Measured: the first calibration
   // after setting the movement cursor reports 0, and every one after it
   // reports 6, with no key pressed in between.
   //
   // That matters because the aim servo calls this several times per click, so
   // the side effect landed on every single click the mod made: the player set
   // the movement cursor, the mod quietly replaced it while aiming, and the
   // click then did nothing at all. Save the mode and put it back.
   // NOTE: obj_under_cursor is deliberately NOT called here.
   //
   // It changes the action cursor as a side effect -- asking the engine what is
   // under the pointer makes it decide what a click there would do, and it
   // leaves that decision behind. Worse, the change is DEFERRED: get_cursor_mode
   // still reads the old value immediately afterwards, so it cannot even be put
   // back on the spot.
   //
   // Calibration is what the aim servo calls, several times per click, so the
   // side effect landed on every click the mod made: the player set the
   // movement cursor, aiming quietly replaced it, and the click did nothing at
   // all. A query that mutates the thing being measured has no place in the
   // measuring loop.
   ouname := "";

   debug_msg("WORLD:calib mouse=" + mx + "," + my
      + " btns=" + btns
      + " under=" + under
      + " cursor=" + g_cursor
      + " match=" + (under == g_cursor)
      + " screen=" + get_screen_width + "x" + get_screen_height
      + " obj=" + ouname + "|");

   // Reading the world moves the cursor. Several of the engine's query
   // functions decide what a click here would do and leave that decision
   // behind, and the change is DEFERRED -- get_cursor_mode still reads the old
   // value on the next line, so it cannot be saved and put back on the spot.
   //
   // Measured: numpad 5 (describe) leaves mode 4, numpad 2 (calibrate) leaves
   // mode 6, while doing nothing, moving the mouse, or stepping the look cursor
   // leave it alone. Stepping is unaffected only because it already opens a
   // restore window -- which is the fix, applied here too.
   //
   // This matters because the aim servo calibrates several times per click: the
   // player set the movement cursor, aiming replaced it, and the click then did
   // nothing at all.
   g_restore_ticks := 8;
end

/*
 * live_critter_at_cursor  --  is there something alive on the look hex?
 *
 * Sets g_hascritter. A procedure rather than a returned value because SSL's
 * support for value-returning procedures is not worth relying on here.
 */
/*
 * THE SCANNER
 *
 * The hex cursor lets you feel your way around one tile at a time, which is
 * fine for what is next to you and hopeless for finding the door on the far
 * side of a room. The scanner is the other half: it asks the engine for
 * everything of a given kind and reads it out nearest first.
 *
 *   shift [ / shift ]   previous / next category
 *   [ / ]               previous / next entry within the category
 *   /                   move the look cursor to the selected entry
 *
 * Choosing an entry does NOT move the cursor. Listing what is around you and
 * going there are different intentions, and a scanner that walked the cursor
 * every time you stepped through a list would make simply looking impossible.
 *
 * ONLY WHAT IS ON SCREEN. `list_as_array` happily returns every object on the
 * map including the ones behind walls, and reading those out would be x-ray
 * vision -- exactly what this mod refuses to do. `obj_on_screen` is the
 * engine's own "am I drawing this" test, so it draws the line in precisely the
 * same place the game draws it for a sighted player. That a sighted player
 * takes in a whole screen at a glance is why listing it serially is parity
 * rather than advantage.
 */

#define SCAN_CRITTERS       (0)
#define SCAN_ITEMS          (1)
#define SCAN_SCENERY        (2)
#define SCAN_CATEGORIES     (3)

// Art index of the blank placeholder frame. Objects drawn with it are the
// engine's own invisible furniture; see scan_keep.
#define ART_INVISIBLE       (21)

procedure scan_list_type(variable cat) begin
   if (cat == SCAN_CRITTERS) then return LIST_CRITTERS;
   if (cat == SCAN_ITEMS)    then return LIST_GROUNDITEMS;
   return LIST_SCENERY;
end

/*
 * scan_keep  --  should this object be offered at all?
 *
 * Sets g_hascritter as a general-purpose "yes" flag (SSL procedures returning
 * values are not worth relying on here).
 *
 * The engine's own furniture is the awkward part. A live map is carpeted in
 * "Scroll Blocker", "Block Hex Auto Inviso" and unnamed spatial triggers that
 * no sighted player perceives. obj_is_visible_flag does NOT reject them -- it
 * returns true for all of it -- so every object considered is logged with its
 * pid, flags and type, and the rule will be derived from that data rather than
 * guessed at. Until then obj_on_screen does most of the work, since the engine
 * does not draw what it does not draw.
 */
procedure scan_keep(variable obj) begin
   variable ty;
   g_hascritter := 0;
   if (not obj) then return;
   if (obj == dude_obj) then return;

   ty := obj_type(obj);
   if (ty == OBJ_TYPE_SPATIAL) then return;

   // The engine's invisible furniture, rejected by the art it is drawn with.
   //
   // Derived from 81,000 logged samples rather than guessed at. Every one of
   // Block Hex Auto Inviso, Blocking Hex (NoLight), Secret Blocking Hex, Exit
   // Grid Map Marker and Light Source is drawn with fid 0x02000015 -- art index
   // 21, the blank placeholder -- and not one of the 23 real object types seen
   // uses it. Flags were the obvious candidate and turned out useless: the same
   // bits appear on Chasm and Temple as on the blockers.
   //
   // Note this cannot be left to obj_on_screen. Block Hex Auto Inviso was
   // reported on screen 9,492 times out of 28,480: the engine happily "draws"
   // an invisible object.
   //
   // Critters are exempt because a critter's fid encodes animation state, not a
   // scenery art index, so the comparison would be meaningless for them.
   if (ty != OBJ_TYPE_CRITTER) then begin
      if ((obj_art_fid(obj) bwand 0xFFF) == ART_INVISIBLE) then return;
   end

   if (not obj_on_screen(obj)) then return;
   if (not obj_is_visible_flag(obj)) then return;

   // A corpse is worth knowing about, but it is not a critter you can deal
   // with, and offering one as a target wastes a turn.
   if (ty == OBJ_TYPE_CRITTER) then begin
      if (is_critter_dead(obj)) then return;
      // Only critters get the perception test, and only critters:
      // obj_can_see_obj reaches for critter fields and null-dereferenced at
      // 0x004AA6AE when handed scenery.
      if (not obj_can_see_obj(dude_obj, obj)) then return;
   end

   g_hascritter := 1;
end

/*
 * scan_do  --  collect, group, select, and either report or jump.
 *
 * Three levels, because a category can hold dozens of one thing and stepping
 * through them one at a time is unusable:
 *
 *   category   critters / items / scenery        ctrl [ ]
 *   type       "Torch", "Rocks", "Giant Ant"     [ ]
 *   instance   which of the six torches          shift [ ]
 *
 * Types are ordered by their nearest member, and instances within a type by
 * distance, so the first thing offered is always the closest.
 *
 * Rebuilt from the engine on every keypress. Critters move; a cached list would
 * describe a world that had moved on, which is the desync that sank the first
 * version of this mod.
 */
procedure scan_do(variable level, variable dojump) begin
   variable objs, total, i, j, k, obj, here, n, cands, dists, names;
   variable best, bestd, tmp, ntypes, seen, typename, isnew, ninst, chosen;

   here := tile_num(dude_obj);
   objs := list_as_array(scan_list_type(g_scan_cat));
   total := 0;
   if (objs) then begin
      total := len_array(objs);
   end

   cands := temp_array(total + 1, 0);
   dists := temp_array(total + 1, 0);
   names := temp_array(total + 1, 0);
   n := 0;
   i := 0;
   while (i < total) do begin
      obj := objs[i];
      call scan_keep(obj);
      if (g_hascritter) then begin
         cands[n] := obj;
         dists[n] := tile_distance(here, tile_num(obj));
         // Cached once per object: grouping compares names repeatedly, and
         // asking the engine for each comparison would be hundreds of calls.
         call obj_label(obj);
         names[n] := g_label;
         n := n + 1;
      end
      i := i + 1;
   end

   if (n == 0) then begin
      debug_msg("SCAN:none " + g_scan_cat + "|");
      return;
   end

   // Sort the whole list by distance. Grouping reads it in order, so that
   // types come out nearest-first and so do the instances within each type.
   i := 0;
   while (i < n - 1) do begin
      best := i;
      bestd := dists[i];
      j := i + 1;
      while (j < n) do begin
         if (dists[j] < bestd) then begin
            best := j;
            bestd := dists[j];
         end
         j := j + 1;
      end
      if (best != i) then begin
         tmp := cands[i];  cands[i] := cands[best];  cands[best] := tmp;
         tmp := dists[i];  dists[i] := dists[best];  dists[best] := tmp;
         tmp := names[i];  names[i] := names[best];  names[best] := tmp;
      end
      i := i + 1;
   end

   // How many distinct types, counting each name the first time it appears.
   ntypes := 0;
   i := 0;
   while (i < n) do begin
      isnew := 1;
      j := 0;
      while (j < i) do begin
         if (string_compare(names[j], names[i])) then begin
            isnew := 0;
            j := i;
         end
         j := j + 1;
      end
      if (isnew) then ntypes := ntypes + 1;
      i := i + 1;
   end

   if (g_scan_type >= ntypes) then g_scan_type := ntypes - 1;
   if (g_scan_type < 0) then g_scan_type := ntypes - 1;

   // Name of the selected type.
   seen := -1;
   typename := "";
   i := 0;
   while (i < n) do begin
      isnew := 1;
      j := 0;
      while (j < i) do begin
         if (string_compare(names[j], names[i])) then begin
            isnew := 0;
            j := i;
         end
         j := j + 1;
      end
      if (isnew) then begin
         seen := seen + 1;
         if (seen == g_scan_type) then begin
            typename := names[i];
            i := n;
         end
      end
      i := i + 1;
   end

   ninst := 0;
   i := 0;
   while (i < n) do begin
      if (string_compare(names[i], typename)) then ninst := ninst + 1;
      i := i + 1;
   end
   if (g_scan_inst >= ninst) then g_scan_inst := ninst - 1;
   if (g_scan_inst < 0) then g_scan_inst := ninst - 1;

   k := -1;
   chosen := 0;
   i := 0;
   while (i < n) do begin
      if (string_compare(names[i], typename)) then begin
         k := k + 1;
         if (k == g_scan_inst) then begin
            chosen := i;
            i := n;
         end
      end
      i := i + 1;
   end

   if (dojump) then begin
      g_cursor := tile_num(cands[chosen]);
      call recenter_view;
      debug_msg("SCAN:jump " + g_cursor + "|");
      call describe_cursor;
      return;
   end

   debug_msg("SCAN:entry " + g_scan_cat + "|" + g_scan_type + "|" + ntypes
      + "|" + typename + "|" + g_scan_inst + "|" + ninst
      + "|" + dists[chosen]
      + "|" + rotation_to_tile(here, tile_num(cands[chosen]))
      + "|" + level + "|");
   g_restore_ticks := 8;
end

procedure scan_instance(variable delta) begin
   g_scan_inst := g_scan_inst + delta;
   call scan_do(0, 0);
end

procedure scan_type(variable delta) begin
   g_scan_type := g_scan_type + delta;
   g_scan_inst := 0;
   call scan_do(1, 0);
end

procedure scan_category(variable delta) begin
   g_scan_cat := g_scan_cat + delta;
   if (g_scan_cat < 0) then g_scan_cat := SCAN_CATEGORIES - 1;
   if (g_scan_cat >= SCAN_CATEGORIES) then g_scan_cat := 0;
   g_scan_type := 0;
   g_scan_inst := 0;
   call scan_do(2, 0);
end

procedure scan_jump begin
   call scan_do(0, 1);
end

/*
 * prepare_cursor  --  set the cursor to match what the click is about to do.
 *
 * The mod points; it does not get to decide what a click means. But it turns
 * out it must SET the mode all the same, because reading the world changes the
 * cursor as a side effect and aiming reads the world several times. Leaving the
 * player to set it themselves and preserving their choice cannot be made to
 * work: the restore that undoes the engine's meddling also undoes theirs.
 *
 * So the mode is chosen from what the player has actually expressed:
 *   a skill armed from the number row  -> that skill
 *   a living enemy on the look hex     -> the targeting cursor, so it attacks
 *   anything else                      -> the movement cursor, so it walks
 *
 * This is the choice a sighted player makes by looking at what they are
 * pointing at, and every part of it is something they told us: which skill,
 * which hex. Numpad 0 remains the explicit reset, and is the only thing that
 * disarms a skill.
 */
/*
 * on_useskill  --  HOOK_USESKILLON, fired when a skill is applied to something.
 *
 * Disarms our record of it. The engine drops its own skill cursor after a use,
 * and if we did not follow suit the mod would keep re-arming it: a lockpick
 * readied for a door was still armed when the next fight started, so every
 * attack was issued as an attempt to pick the lock on a scorpion.
 */
procedure on_useskill begin
   g_armedskill := 0;
   debug_msg("WORLD:skillused|");
end

procedure prepare_cursor begin
   variable want, ou, ouname;

   // Decide from what is UNDER THE POINTER, not from what is on the look hex.
   // Those are not the same thing: the pointer is walked up an object's sprite
   // to reach it, and a tall sprite belongs to a tile behind the one the
   // pointer ends up over. Judging by the look hex chose the movement cursor
   // while the pointer sat squarely on a Giant Ant, so every attack in a fight
   // was issued as an order to walk.
   //
   // Critters are asked for first and separately. obj_under_cursor with
   // onlyCritter set ignores their cover; without it the engine "can't check
   // critters under objects", so an enemy standing in scenery goes unseen.
   ou := obj_under_cursor(1, 0);
   if (not ou) then begin
      ou := obj_under_cursor(0, 0);
   end

   ouname := "";
   if (ou) then begin
      call obj_label(ou);
      ouname := g_label;
   end

   if (g_armedskill > 0) then begin
      want := g_armedskill;
   end else if (ou and obj_type(ou) == OBJ_TYPE_CRITTER and not is_critter_dead(ou)) then begin
      if (combat_is_initialized) then begin
         want := CURSOR_TARGETING;   // a click attacks
      end else begin
         want := CURSOR_COMMAND;     // a click talks, or whatever is default
      end
   end else if (ou) then begin
      // A door, a container, scenery. COMMAND performs a thing's default
      // action; MOVEMENT merely tries to walk onto its hex, which a door
      // blocks -- so an ordinary unlocked door appeared to do nothing at all.
      want := CURSOR_COMMAND;
   end else begin
      want := CURSOR_MOVEMENT;
   end

   set_cursor_mode(want);
   g_playercursor := want;
   g_restore_ticks := 0;
   g_lastcursormode := get_cursor_mode;
   debug_msg("WORLD:prepare " + want + "|" + ouname + "|");
end

/*
 * obj_label  --  the object's name, plus whether it is locked or open.
 *
 * Sets g_label. Doors are the case that matters: "there is a door" and "there
 * is a door you cannot open" are different facts, and the second one is the
 * reason a click on it appears to do nothing at all.
 *
 * The name is the game's own. "locked" and "open" are ours, in the same
 * category as distances and bearings -- scaffolding describing how to get
 * around, which the game has no phrase for because it simply shows you.
 */
procedure obj_label(variable obj) begin
   g_label := obj_name(obj);
   if (obj_type(obj) != OBJ_TYPE_CRITTER) then begin
      if (obj_is_locked(obj)) then begin
         g_label := g_label + ", locked";
      end else if (obj_is_open(obj)) then begin
         g_label := g_label + ", open";
      end
   end
end

procedure live_critter_at_cursor begin
   variable objs, total, i, obj;
   g_hasobject := 0;
   objs := tile_get_objs(g_cursor, elevation(dude_obj));
   total := 0;
   if (objs) then begin
      total := len_array(objs);
   end
   i := 0;
   while (i < total) do begin
      obj := objs[i];
      if (obj and obj != dude_obj) then begin
         if (obj_type(obj) == OBJ_TYPE_CRITTER) then begin
            // Corpses share a hex with the living, because a dead critter
            // stops blocking its tile. Offering a body as an attack target
            // would waste a turn's action points on nothing.
            if (not is_critter_dead(obj)) then begin
               g_hascritter := 1;
            end
         end else if (obj_type(obj) != OBJ_TYPE_SPATIAL) then begin
            // Something you could act on -- a door, a container, scenery.
            // The engine's invisible furniture is drawn with the blank
            // placeholder art and is not a thing anyone can touch.
            if ((obj_art_fid(obj) bwand 0xFFF) != ART_INVISIBLE) then begin
               g_hasobject := 1;
            end
         end
      end
      i := i + 1;
   end
   // No free_array: tile_get_objs returns a temporary array, auto-deleted at
   // end of frame. Freeing it by hand is a double free and crashes the engine.
   g_hascritter := 0;
end

/*
 * force_action_cursor  --  set the cursor to match what the look hex holds.
 *
 * Fallout decides what a left click does from the cursor mode, so a blind
 * player needs that mode set deliberately rather than toggled blindly with
 * right-click. The script picks it, because the script is what knows both
 * whether combat is running and what is standing on the selected hex.
 *
 * In combat, with a living critter on the look hex, that means the targeting
 * cursor: a click attacks. Otherwise the movement cursor: a click walks. This
 * is the same decision a sighted player makes by looking at what they are
 * pointing at, and it keeps one key -- "do the obvious thing with the hex I
 * have chosen" -- instead of making the player track cursor state themselves.
 *
 * There is no ambiguity to worry about: a living critter blocks its hex, so
 * "walk there" was never available for the hexes this targets.
 */
procedure force_action_cursor begin
   variable before, want;

   g_hascritter := 0;
   if (combat_is_initialized) then begin
      call live_critter_at_cursor;
   end

   if (g_hascritter) then begin
      want := CURSOR_TARGETING;
   end else begin
      want := CURSOR_MOVEMENT;
   end

   g_armedskill := 0;   // the explicit reset: numpad 0 disarms a skill
   before := get_cursor_mode;
   set_cursor_mode(want);
   g_playercursor := want;
   g_restore_ticks := 0;
   g_lastcursormode := get_cursor_mode;

   // Always answer, but do not give the same long answer twice. Silence is the
   // one response a blind player cannot act on -- it reads exactly like the key
   // never arrived, which is how this key got written off as broken. But the
   // full "movement cursor, a click walks you there" on every press is its own
   // problem: pressed twice to be sure, it just repeats itself. So a press that
   // changed nothing gets a short acknowledgement instead.
   if (before == g_lastcursormode) then begin
      debug_msg("WORLD:cursorok " + g_lastcursormode);
   end else begin
      debug_msg("WORLD:cursormode " + g_lastcursormode);
   end
end

/*
 * step_north / step_south  --  the directions a hex grid does not have.
 *
 * There is no north. The two upward neighbours are NE and NW, mirror images
 * about the vertical, so going "up" means alternating them -- and which one you
 * need next depends on the row's parity. Doing that by hand is what makes
 * tracing a wall drift: pressing NE and W alternately very nearly cancels, so
 * some pairs climb and some do not, and after a few you are several hexes off
 * the wall without having noticed.
 *
 * g_ndrift remembers which way the staircase currently leans and takes the
 * step that cancels it, so repeated presses trace a straight line up the screen
 * and every second one returns to the starting column.
 *
 * Nothing here is a liberty: each press is one ordinary hex step. It is the
 * choice between two legal steps that a sighted player makes by eye.
 */
procedure step_north begin
   if (g_ndrift > 0) then begin
      g_ndrift := g_ndrift - 1;
      call step_cursor(DIR_NW);
   end else begin
      g_ndrift := g_ndrift + 1;
      call step_cursor(DIR_NE);
   end
end

procedure step_south begin
   if (g_ndrift > 0) then begin
      g_ndrift := g_ndrift - 1;
      call step_cursor(DIR_SW);
   end else begin
      g_ndrift := g_ndrift + 1;
      call step_cursor(DIR_SE);
   end
end

procedure snap_to_dude begin
   g_cursor := tile_num(dude_obj);
   call recenter_view;
   debug_msg("WORLD:snap");
   call describe_cursor;
end

procedure describe_cursor begin
   variable elev, here, dist, objs, total, count, names, i, obj, nm, ty;

   elev := elevation(dude_obj);
   here := tile_num(dude_obj);
   dist := tile_distance(here, g_cursor);

   objs := tile_get_objs(g_cursor, elev);
   total := 0;
   if (objs) then begin
      total := len_array(objs);
   end

   count := 0;
   names := "";
   i := 0;
   while (i < total) do begin
      obj := objs[i];
      if (obj) then begin
         ty := obj_type(obj);

         if (obj == dude_obj) then begin
            if (count > 0) then names := names + ", ";
            names := names + "you";
            count := count + 1;

         // Filter out the engine's invisible furniture. A live map is carpeted
         // in "Scroll Blocker", "Block Hex Auto Inviso" and unnamed spatial
         // script triggers -- none of which a sighted player perceives, so
         // announcing them would both mislead and drown out real content.
         // obj_is_visible_flag is a plain flag read, so unlike obj_can_see_obj
         // it is safe to call on any object type.
         end else if (ty != OBJ_TYPE_SPATIAL and obj_is_visible_flag(obj)) then begin

            if (ty == OBJ_TYPE_CRITTER) then begin
               // Only critters get the line-of-sight and stealth test, and
               // only critters: obj_can_see_obj reaches for critter fields and
               // null-dereferenced at 0x004AA6AE when handed scenery.
               debug_msg("WORLD:dbgLOS obj=" + obj);
               if (obj_can_see_obj(dude_obj, obj)) then begin
                  if (count > 0) then names := names + ", ";
                  names := names + obj_name(obj);
                  count := count + 1;
               end
            end else begin
               // Diagnostic: "Scroll Blocker" and "Block Hex Auto Inviso" pass
               // obj_is_visible_flag despite being invisible to a player, so we
               // need a structural property to reject them by. Filtering on the
               // English name would break localisation, so log pid/fid/flags
               // and pick a rule from the data.
               debug_msg("WORLD:objdbg pid=" + obj_pid(obj) + " fid=" + obj_art_fid(obj)
                  + " flags=" + get_flags(obj) + " ty=" + ty + " nm=" + obj_name(obj));
               if (count > 0) then names := names + ", ";
               call obj_label(obj);
               names := names + g_label;
               count := count + 1;
            end
         end
      end
      i := i + 1;
   end

   // No free_array: tile_get_objs returns a TEMPORARY array and sfall deletes
   // those at end of frame. Freeing by hand is a double free -- it hard-crashed
   // the engine the first time this ran.

   if (count == 0) then begin
      names := "empty";
   end
   // Trailing '|' terminates the line: the engine appends its own debug output
   // to ours without always starting a new line, and object names are the last
   // field here. Everything after the bar is discarded.
   debug_msg("WORLD:hex " + g_cursor + " dist " + dist + " : " + names + "|");

   // Reading the world moves the cursor. Several of the engine's query
   // functions decide what a click here would do and leave that decision
   // behind, and the change is DEFERRED -- get_cursor_mode still reads the old
   // value on the next line, so it cannot be saved and put back on the spot.
   //
   // Measured: numpad 5 (describe) leaves mode 4, numpad 2 (calibrate) leaves
   // mode 6, while doing nothing, moving the mouse, or stepping the look cursor
   // leave it alone. Stepping is unaffected only because it already opens a
   // restore window -- which is the fix, applied here too.
   //
   // This matters because the aim servo calibrates several times per click: the
   // player set the movement cursor, aiming replaced it, and the click then did
   // nothing at all.
   g_restore_ticks := 8;
end
